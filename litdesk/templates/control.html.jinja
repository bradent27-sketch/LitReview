<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>LitDesk — Control Panel</title>
<style>
  :root { color-scheme: light dark; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    max-width: 780px; margin: 2rem auto; padding: 0 1rem;
    line-height: 1.45; color: #1a1a1a; background: #fdfdfc;
  }
  @media (prefers-color-scheme: dark) {
    body { color: #e8e6e3; background: #1c1c1a; }
    .card { border-color: #3a3a36 !important; background: #232320 !important; }
    table { color: #e8e6e3; }
    td, th { border-color: #3a3a36 !important; }
    .log-box { background: #0b0b0a !important; }
  }
  h1 { margin-bottom: 0.3rem; }
  h2 { font-size: 1.05rem; margin: 0 0 0.6rem 0; }
  .card {
    border: 1px solid #e2e0db; border-radius: 8px; padding: 1rem 1.2rem; margin-bottom: 1.1rem; background: #fff;
  }
  .btn {
    font-size: 0.95rem; padding: 0.5rem 1.1rem; border-radius: 6px; border: 1px solid #1c5fc4;
    background: #1c5fc4; color: #fff; cursor: pointer;
  }
  .btn:hover { background: #164a9c; }
  .btn:disabled { opacity: 0.6; cursor: default; }
  .btn-secondary { background: #fff; color: #1c5fc4; }
  @media (prefers-color-scheme: dark) { .btn-secondary { background: #232320; } }
  .log-box {
    background: #111; color: #ddd; font-family: ui-monospace, monospace; font-size: 0.82rem;
    padding: 0.75rem; border-radius: 6px; height: 220px; overflow-y: auto; white-space: pre-wrap;
    margin-top: 0.8rem;
  }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  td, th { padding: 0.3rem 0.5rem; border-bottom: 1px solid #e2e0db; text-align: left; }
  .tools-grid { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .tools-grid form { margin: 0; }
  .result-box {
    border: 1px solid #2f9e44; background: #ebfbee; color: #1a1a1a;
    padding: 0.7rem 1rem; border-radius: 6px; margin-bottom: 1.2rem;
  }
  .result-box.is-error { border-color: #e03131; background: #fff0f0; }
  .result-box pre { white-space: pre-wrap; font-size: 0.85rem; margin: 0.4rem 0 0 0; }
  .notif-item { font-size: 0.88rem; padding: 0.25rem 0; }
  .notif-unseen { font-weight: 600; }
  .muted { color: #888; font-size: 0.85rem; }
</style>
</head>
<body>
{% set active = "control" %}
{% include "_nav.html.jinja" %}
<h1>Control Panel</h1>

{% if result %}
<div class="result-box {{ 'is-error' if result.is_error else '' }}">
  <strong>{{ result.tool }}</strong>
  <pre>{{ result.output }}</pre>
</div>
{% endif %}

<div class="card">
  <h2>Run digest now</h2>
  <p class="muted">Ingests new papers, ranks them, rebuilds today's digest — the same as running <code>litdesk run</code>.</p>
  <button id="run-btn" class="btn" onclick="startRun()">Run now</button>
  <div id="run-log" class="log-box"></div>
</div>

<div class="card">
  <h2>Recent runs</h2>
  {% if recent_runs %}
  <table>
    <tr><th>Started</th><th>Source</th><th>Fetched</th><th>New</th><th>Deduped</th><th>Error</th></tr>
    {% for r in recent_runs %}
    <tr>
      <td>{{ r.started_at }}</td><td>{{ r.source }}</td><td>{{ r.n_fetched }}</td>
      <td>{{ r.n_new }}</td><td>{{ r.n_deduped }}</td><td>{{ r.error or "" }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="muted">No runs logged yet.</p>
  {% endif %}
</div>

<div class="card">
  <h2>Notifications {% if unseen_count %}<span class="muted">({{ unseen_count }} new)</span>{% endif %}</h2>
  {% if notifications %}
    {% for n in notifications %}
    <div class="notif-item {{ 'notif-unseen' if not n.seen }}">[{{ n.type }}] {{ n.created_at }} — {{ n.message }}</div>
    {% endfor %}
  {% else %}
    <p class="muted">No notifications yet.</p>
  {% endif %}
  {% if unseen_count %}
  <form method="post" action="/control/notifications/mark-seen" style="margin-top:0.6rem;">
    <button type="submit" class="btn btn-secondary">Mark all seen</button>
  </form>
  {% endif %}
</div>

<div class="card">
  <h2>Tools</h2>
  <div class="tools-grid">
    <form method="post" action="/control/retrain"><button type="submit" class="btn btn-secondary">Check ranker accuracy</button></form>
    <form method="post" action="/control/export"><button type="submit" class="btn btn-secondary">Export BibTeX of liked papers</button></form>
    <form method="post" action="/control/check-retractions"><button type="submit" class="btn btn-secondary">Check for retractions</button></form>
    <form method="post" action="/control/synthesis"><button type="submit" class="btn btn-secondary">Weekly synthesis</button></form>
  </div>
</div>

<script>
let polling = false;

function renderLog(lines) {
  const box = document.getElementById('run-log');
  box.textContent = lines.join('\n');
  box.scrollTop = box.scrollHeight;
}

async function pollStatus() {
  const btn = document.getElementById('run-btn');
  try {
    const resp = await fetch('/control/run-status');
    const data = await resp.json();
    renderLog(data.log);
    if (data.running) {
      btn.disabled = true;
      btn.textContent = 'Running…';
      polling = true;
      setTimeout(pollStatus, 1500);
    } else {
      btn.disabled = false;
      polling = false;
      if (data.finished_at) {
        btn.textContent = data.had_error ? 'Run now (last run had errors)' : 'Run now (last run: done)';
      } else {
        btn.textContent = 'Run now';
      }
    }
  } catch (err) {
    if (polling) setTimeout(pollStatus, 3000);
  }
}

async function startRun() {
  const btn = document.getElementById('run-btn');
  btn.disabled = true;
  btn.textContent = 'Starting…';
  await fetch('/control/run', {method: 'POST'});
  pollStatus();
}

window.addEventListener('DOMContentLoaded', pollStatus);
</script>
</body>
</html>
