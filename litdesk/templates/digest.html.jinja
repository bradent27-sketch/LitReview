<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>LitDesk — {{ run_date }}</title>
<style>
  :root { color-scheme: light dark; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    max-width: 780px; margin: 2rem auto; padding: 0 1rem;
    line-height: 1.45; color: #1a1a1a; background: #fdfdfc;
  }
  @media (prefers-color-scheme: dark) {
    body { color: #e8e6e3; background: #1c1c1a; }
    .paper { border-color: #3a3a36 !important; }
    .abstract { color: #b8b6b2 !important; }
    .meta { color: #9a9894 !important; }
    a { color: #7db8ff; }
  }
  header { margin-bottom: 1.5rem; }
  header h1 { margin-bottom: 0.1rem; }
  header .sub { color: #777; font-size: 0.95rem; }
  .catchup-banner {
    background: #fff3cd; border: 1px solid #ffe69c; color: #664d03;
    padding: 0.6rem 1rem; border-radius: 6px; margin-bottom: 1.5rem; font-size: 0.9rem;
  }
  .paper {
    border: 1px solid #e2e0db; border-left-width: 5px; border-radius: 6px;
    padding: 0.9rem 1.1rem; margin-bottom: 0.9rem;
  }
  .band-high { border-left-color: #2f9e44; }
  .band-medium { border-left-color: #f0a500; }
  .band-low { border-left-color: #adb5bd; }
  .band-forced { border-left-color: #7048e8; }
  .paper h2 { font-size: 1.08rem; margin: 0 0 0.25rem 0; }
  .paper h2 a { text-decoration: none; color: inherit; }
  .paper h2 a:hover { text-decoration: underline; }
  .meta { color: #666; font-size: 0.86rem; margin-bottom: 0.4rem; }
  .badge {
    display: inline-block; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.02em;
    padding: 0.1rem 0.45rem; border-radius: 10px; margin-left: 0.4rem; vertical-align: middle;
  }
  .badge-preprint { background: #e7f0ff; color: #1c5fc4; }
  .badge-forced { background: #f1eafe; color: #6425d0; }
  .badge-score { background: #f1f3f5; color: #495057; }
  .band-high .badge-score { background: #ebfbee; color: #2f9e44; }
  .band-medium .badge-score { background: #fff8e1; color: #a06800; }
  details.abstract summary {
    cursor: pointer; color: #495057; font-size: 0.86rem; user-select: none;
  }
  .abstract { color: #444; font-size: 0.92rem; margin-top: 0.4rem; }
  .explain { margin-top: 0.5rem; font-size: 0.8rem; color: #888; font-style: italic; }
  footer { margin-top: 2rem; color: #999; font-size: 0.8rem; text-align: center; }
</style>
</head>
<body>
<header>
  <h1>LitDesk</h1>
  <div class="sub">{{ run_date }} &middot; {{ entries|length }} paper{{ "s" if entries|length != 1 else "" }}</div>
</header>

{% if is_catchup %}
<div class="catchup-banner">
  You were away {{ gap_days }} day{{ "s" if gap_days != 1 else "" }} — {{ n_candidates_total }} new papers piled up,
  showing the top {{ entries|length }} instead of all of them.
</div>
{% endif %}

{% if not entries %}
  <p>No new papers to show today.</p>
{% endif %}

{% for e in entries %}
<article class="paper {{ 'band-forced' if e.forced_include else 'band-' + (e.band or 'low') }}">
  <h2>
    {% if e.url %}<a href="{{ e.url }}" target="_blank" rel="noopener">{{ e.title }}</a>{% else %}{{ e.title }}{% endif %}
    {% if e.is_preprint %}<span class="badge badge-preprint">preprint</span>{% endif %}
    {% if e.forced_include %}<span class="badge badge-forced">always include: {{ e.journal }}</span>{% endif %}
  </h2>
  <div class="meta">
    {{ e.journal or "—" }} &middot; {{ e.date_published or "date unknown" }}
    {% if e.authors %} &middot; {{ e.authors[:3]|join(", ") }}{% if e.authors|length > 3 %} et al.{% endif %}{% endif %}
    <span class="badge badge-score">score {{ "%.2f"|format(e.score) }}</span>
  </div>
  {% if e.abstract %}
  <details class="abstract">
    <summary>Abstract</summary>
    <div class="abstract">{{ e.abstract }}</div>
  </details>
  {% endif %}
  {% if e.nearest_title %}
  <div class="explain">closest to: “{{ e.nearest_title }}” (similarity {{ "%.2f"|format(e.nearest_similarity) }})</div>
  {% endif %}
</article>
{% endfor %}

<footer>Generated by LitDesk &middot; {{ run_date }}</footer>
</body>
</html>
